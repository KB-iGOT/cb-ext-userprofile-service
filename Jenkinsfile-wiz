stage('Scan Repository') {
    steps {
        script {
            env.REPO_NAME = sh(
                script: 'basename -s .git $(git config --get remote.origin.url)',
                returnStdout: true
            ).trim()

            env.BRANCH_NAME = sh(
                script: 'git rev-parse --abbrev-ref HEAD',
                returnStdout: true
            ).trim()

            env.SCAN_NAME = "${env.REPO_NAME}-${env.BRANCH_NAME}"
        }

        withCredentials([
            string(credentialsId: 'wiz-client-id', variable: 'WIZ_CLIENT_ID'),
            string(credentialsId: 'wiz-client-secret', variable: 'WIZ_CLIENT_SECRET')
        ]) {
            sh '''
                echo "Repository : $REPO_NAME"
                echo "Branch     : $BRANCH_NAME"
                echo "Scan Name  : $SCAN_NAME"

                wizcli dir scan \
                  --client-id "$WIZ_CLIENT_ID" \
                  --client-secret "$WIZ_CLIENT_SECRET" \
                  --name "$SCAN_NAME" \
                  --path .
            '''
        }
    }
}