pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Repository Information') {
            steps {
                script {
                    env.REPO_NAME = sh(
                        script: 'basename -s .git $(git config --get remote.origin.url)',
                        returnStdout: true
                    ).trim()

                    env.SCAN_NAME = "${env.REPO_NAME}-${params.github_release_tag}"

                    echo "Repository : ${env.REPO_NAME}"
                    echo "Branch/Tag : ${params.github_release_tag}"
                    echo "Scan Name  : ${env.SCAN_NAME}"
                }
            }
        }

        stage('Wiz Scan') {
            steps {
                wizcli "dir scan --name ${env.SCAN_NAME} --path ."
            }
        }
    }

    post {
        always {
            echo "Wiz scan completed."
        }

        success {
            echo "Repository scan completed successfully."
        }

        failure {
            echo "Repository scan failed."
        }
    }
}