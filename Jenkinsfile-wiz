pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Scan Repository') {
            steps {
                withCredentials([
                    string(credentialsId: 'wiz-client-id', variable: 'WIZ_CLIENT_ID'),
                    string(credentialsId: 'wiz-client-secret', variable: 'WIZ_CLIENT_SECRET')
                ]) {
                    sh '''
                        wizcli dir scan \
                          --client-id "$WIZ_CLIENT_ID" \
                          --client-secret "$WIZ_CLIENT_SECRET" \
                          --path .
                    '''
                }
            }
        }
    }
}